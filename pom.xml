<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.javaspeak.gof</groupId>
    <artifactId>gof</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>gangoffour</name>
    <description>Gang of Four design pattern examples in modern Java</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <slf4j.version>2.0.16</slf4j.version>
        <log4j.version>2.24.3</log4j.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        To run the java classes type:
            mvn exec:java@command
            mvn exec:java@chainofresponsibility
            mvn exec:java@interpreter
            mvn exec:java@iterator
            mvn exec:java@mediator
            mvn exec:java@memento
            mvn exec:java@observer
            mvn exec:java@state
            mvn exec:java@strategy
            mvn exec:java@templatemethod
            mvn exec:java@visitor
            mvn exec:java@abstractfactory
            mvn exec:java@builder
            mvn exec:java@factorymethod
            mvn exec:java@prototype
            mvn exec:java@singleton
            mvn exec:java@adapter
            mvn exec:java@bridge
            mvn exec:java@composite
            mvn exec:java@decorator
            mvn exec:java@facade
            mvn exec:java@flyweight
            mvn exec:java@proxy
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>doclint</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>chainofresponsibility</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.chainofresponsibility.ChainOfResponsibilityApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>command</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.command.CommandApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>interpreter</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.interpreter.InterpreterApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>iterator</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.iterator.IteratorApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mediator</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.mediator.MediatorApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>memento</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.memento.MementoApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>observer</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.observer.ObserverApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>state</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.state.StateApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>strategy</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.strategy.StrategyApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>templatemethod</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.templatemethod.TemplateMethodApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>visitor</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.behavioural.visitor.VisitorApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>abstractfactory</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.creational.abstractfactory.AbstractFactoryApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>builder</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.creational.builder.BuilderApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>factorymethod</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.creational.factorymethod.FactoryMethodApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prototype</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.creational.prototype.PrototypeApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>singleton</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.creational.singleton.SingletonApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>adapter</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.adapter.AdapterApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bridge</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.bridge.BridgeApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>composite</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.composite.CompositeApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>decorator</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.decorator.DecoratorApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>facade</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.facade.FacadeApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flyweight</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.flyweight.FlyweightApplication</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>proxy</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.javaspeak.designpatterns.go4.structural.proxy.ProxyApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
